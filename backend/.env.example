# ---------------------------------------------------------------------------
# Copy to .env for local development. The defaults below are safe on a laptop
# and refused in production: settings.validate_runtime() fails startup if a
# secret is missing when ENVIRONMENT is production/staging.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# SQLite is fine for development and a single-instance deployment.
# Postgres for anything multi-instance:
#   postgresql+psycopg2://user:password@host:5432/nexgram
DATABASE_URL=sqlite:///./nexgram_dev.db

# Browser origins allowed to call the API.
# 5173 is the Vite app's `npm run dev`; 4173 is its `npm run preview` and the
# nginx image; 3000 is the Next.js app in frontend/. Copying this file used to
# drop 3000, so that app failed every request with an opaque CORS error.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# Signs access tokens. Left blank in development, where a random value is
# generated per process. REQUIRED in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Guards the operational /api/intelligence/*/generate endpoints, which rebuild
# the whole pipeline. REQUIRED in production.
OPS_TOKEN=

# Session length. Long by default because the target user is on an intermittent
# rural connection and re-authenticating is expensive for them.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Per-IP auth throttling.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

LOG_LEVEL=INFO

# The cut taken on a sourced wholesale order, as a fraction. Every procurement
# quote states this in rupees rather than folding it into the price: the promise
# is the best local price without visiting four suppliers, and a markup the
# shopkeeper discovers later is what breaks it.
PLATFORM_MARGIN_RATE=0.02

# How far a shop will deliver to a household. The runner is a teenager with a
# bicycle, not a courier network, so beyond this an order is refused up front
# rather than accepted and left sitting.
DELIVERY_RADIUS_KM=3.0


# ---------------------------------------------------------------------------
# In-app assistant (Google Gemini)
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey and paste it below, then
# restart the API. Leave it blank and the assistant reports itself as
# unconfigured and the chat button explains how to switch it on - it never
# fails silently.
#
# The key stays server-side. The browser talks to /api/assistant/chat; only
# this process talks to Google.
GEMINI_API_KEY=

# Picked for latency, which is what the assistant is judged on. The -lite tier
# measured ~1.1s to first token here against ~4.7s for the plain flash of the
# same generation; pro is slower again. Google retires these periodically — if
# it reports "model not found", the error names the replacement, so put that
# name here.
GEMINI_MODEL=gemini-3.5-flash-lite

# Caps one reply. Nobody scrolls past this on a phone, and every token beyond
# it is time the user spends waiting.
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TIMEOUT_SECONDS=30

# --- Identity (Clerk) ---------------------------------------------------
#
# Optional. Blank means the Clerk sign-in route is not offered and
# mobile+password carries on unchanged, which is how every checkout without
# these keys behaves.
#
# Clerk proves who someone is once, at sign-in; it does not own the session.
# The token it issues lives 60 seconds and its web SDK cannot refresh one
# offline, so /api/auth/clerk trades it for a NEXGram token that lasts a week
# and survives a dead signal. See app/modules/auth/clerk.py.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# The instance origin, e.g. https://verb-noun-00.clerk.accounts.dev. Derived
# from the publishable key when left blank.
CLERK_ISSUER=

# Origins allowed to present a token, checked against the `azp` claim. Blank
# skips the check — right for local development, wrong in production, where a
# token minted for any other site on the same Clerk instance would otherwise
# be accepted here.
CLERK_AUTHORIZED_PARTIES=
